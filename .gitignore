node_modules/
.direnv/
.turbo/
dist/
.next/
*.log
mise.local.toml
mise.*.local.toml
.mise.local.toml
.mise.*.local.toml

# Generated by `bun standards dev-env` from the three dev layers and any
# authorized broker-owned S3 pair targets they reference; the command refuses
# to write env files or its plaintext transaction artifacts while git would
# track them.
.env.local
.env.local.standards-*.tmp
.env.local.standards-*.bak

# Per-developer/per-machine dev env overrides; may override secret values, so
# `bun standards dev-env` refuses to run while git would track it.
config/dev.local.yaml

# Claude agent worktrees are full parallel checkouts; they are never part of
# this repository's own tree (biome.jsonc force-ignores them from the scanner
# too, and vcs.useIgnoreFile lets Biome honor this entry as well).
.claude/worktrees/

# Deliberately not ignored: sync-standards.lock. Consumers commit their lock —
# it is the drift baseline that `standards check` verifies against.

# Android: Gradle's caches and build output, and the files Android Studio
# writes for one machine. Release keystores live only in secrets/ci.yaml.
apps/android/.gradle/
apps/android/.kotlin/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/android/.idea/
*.jks
*.keystore
*.p12
