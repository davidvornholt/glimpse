{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["biome.jsonc", "biome.base.jsonc"],
  "tasks": {
    "//#lint": {
      "outputs": []
    },
    "//#lint:fix": {
      "cache": false,
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".output/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "test:a11y": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@glimpse/android#build": {
      "dependsOn": ["^build"],
      "outputs": ["app/build/outputs/apk/**"],
      "passThroughEnv": [
        "ANDROID_HOME",
        "ANDROID_SDK_ROOT",
        "JAVA_HOME",
        "GRADLE_OPTS",
        "GRADLE_USER_HOME"
      ]
    },
    "@glimpse/android#test": {
      "dependsOn": ["@glimpse/android#build"],
      "outputs": [],
      "passThroughEnv": [
        "ANDROID_HOME",
        "ANDROID_SDK_ROOT",
        "JAVA_HOME",
        "GRADLE_OPTS",
        "GRADLE_USER_HOME"
      ]
    }
  }
}
